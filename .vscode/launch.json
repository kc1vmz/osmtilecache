    "version": "0.2.0",
    "configurations": [


        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Application",
            "request": "launch",
            "mainClass": "com.kc1vmz.osmtilecache.Application",
            "projectName": "osmtilecache",
            "env": {
                "OSMTC_TEMP_DIR" : "d:\\temp\\osm",
                "OSMTC_DB_DIR" : "d:\\temp\\osm\\data",
                "OSMTC_TILES_DIR" : "d:\\temp\\osm\\data\\tiles\\",
            }
        }
    ]
}